# SkyPlan AI Configuration
SECRET_KEY=skyplan_ai_secure_production_key_2026_dev
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database Configuration (MongoDB)
# If local MongoDB is running: mongodb://localhost:27017/skyplan_ai
# If using MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/skyplan_ai
# If MongoDB is unavailable, SkyPlan AI gracefully falls back to persistent embedded JSON storage
MONGO_URI=mongodb://localhost:27017/skyplan_ai
DB_NAME=skyplan_ai

# Weather Service Configuration
# Default is 'open-meteo' (14-day global forecast, zero API key required, real data)
WEATHER_PROVIDER=open-meteo
# Optional external weather API keys (e.g. WeatherAPI.com or OpenWeatherMap)
WEATHER_API_KEY=

# Background Risk Monitoring
ENABLE_BACKGROUND_SCHEDULER=True
RISK_CHECK_INTERVAL_MINUTES=30

